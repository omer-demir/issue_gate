# VPS proxy configuration; see docs/ops/docker-and-vps.md for prerequisites.
# Set DOMAIN to a real hostname for public HTTPS. A bare localhost address
# may use Caddy's local HTTPS certificates; it does not force plain HTTP.
# Use Caddyfile.local for the loopback-only HTTP development setup.
{$DOMAIN:localhost} {
	encode gzip
	reverse_proxy backend:3000
}
