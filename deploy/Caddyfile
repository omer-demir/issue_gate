# Reverse proxy for the optional later VPS deployment (docker-compose.prod.yml).
#
# Set the DOMAIN environment variable to your real domain name to get
# automatic HTTPS via Let's Encrypt. Left at the default "localhost" this
# serves the backend over HTTP only, suitable for a quick smoke test before
# DNS is pointed at the host.
{$DOMAIN:localhost} {
	encode gzip
	reverse_proxy backend:3000
}
