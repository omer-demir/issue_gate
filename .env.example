# Copy this file:
#   - to .env for local `docker compose up` overrides (optional; dev defaults
#     already work without it), or
#   - to backend.env for the VPS overlay (docker-compose.prod.yml), filled
#     in with real values. Never commit the populated file.

# Required in production (NODE_ENV=production); the backend refuses to start
# with the insecure default once NODE_ENV=production. Generate with e.g.
# `openssl rand -hex 32` and store the real value only in your secrets
# mechanism / backend.env on the host, never in source control.
JWT_SECRET=dev-insecure-secret-change-me

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CHANGE_FEED_PAGE_SIZE=50
CHANGE_FEED_RETENTION=1000

# Local-only: host port the backend is published on.
BACKEND_PORT=3000

# VPS-only: real domain the reverse proxy requests a TLS cert for.
DOMAIN=localhost
