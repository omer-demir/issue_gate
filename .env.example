# Copy to .env for optional local Compose overrides, or to backend.env for
# the standalone VPS configuration. Never commit populated secret files.
# Direct backend npm commands do not load this file automatically.
# See README.md and docs/ops/docker-and-vps.md for setup and VPS blockers.

# Replace this development-only value before using NODE_ENV=production.
# Generate a strong value outside source control, e.g. openssl rand -hex 32.
JWT_SECRET=dev-insecure-secret-change-me

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CHANGE_FEED_PAGE_SIZE=50
# Parsed by the API, but runtime retention/compaction is not implemented.
CHANGE_FEED_RETENTION=1000

# Local Compose host port; use 4000 alongside the web quick start.
# The backend container continues to listen on 3000.
BACKEND_PORT=3000

# VPS-only: public domain for Caddy HTTPS. localhost is not a public TLS setup.
DOMAIN=localhost
