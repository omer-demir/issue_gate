{
  "name": "Issue Gate",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "forwardPorts": [3000, 4000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (use port 8080 for the app)",
      "onAutoForward": "silent"
    },
    "4000": {
      "label": "Sync API",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Issue Gate (web + API)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/home/node/flutter",
        "eslint.workingDirectories": ["web"]
      }
    }
  }
}
